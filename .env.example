# AIHub — пример конфигурации (.env)
# Секреты (токен бота, owner id, cookie_secret, secret_path, пароль OpenCode)
# хранятся в data/vault.enc — настраиваются мастером: ./scripts/setup.sh

# Public URL (заполняется сторожем туннеля)
# hybrid = LAN без TS + Tailscale вне дома (рекомендуется)
# tailscale = только mesh; cloudflare = публичный quick tunnel
NETWORK_MODE=hybrid
PUBLIC_URL=

# DeepSeek Harness
DSH_HOME=~/.dsh
DSH_WEB_LOG=~/.dsh/web.log
DSH_WEB_HOST=127.0.0.1
DSH_WEB_PORT=3080

# OpenCode
OPENCODE_SERVE_HOST=127.0.0.1
OPENCODE_SERVE_PORT=4096
OPENCODE_SERVER_USERNAME=

# Gatekeeper
GATEKEEPER_HOST=0.0.0.0
GATEKEEPER_PORT=8787

# Environment
ENV=production
# off | loopback | lan — кому доступен /auth/dev без Telegram
LOCAL_LOGIN=loopback
LOG_DIR=~/Library/Logs/AIHub
LOG_LEVEL=INFO
DATA_DIR=./data

# Агрегатор (отдельный процесс, опционально)
AGGREGATOR_PORT=8789
